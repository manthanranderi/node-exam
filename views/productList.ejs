<%- include("partials/navbar") %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Product Dashboard</h2>
            <p class="text-muted">Manage all products</p>
        </div>

        <a href="/products/add" class="btn btn-primary">
            + Add Product
        </a>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">All Products</h5>

        </div>

        <div class="card-body">

            <% if(products.length > 0){ %>

                <div class="row">

                    <% products.forEach(product => { %>

                        <div class="col-md-6 col-lg-4 mb-4">

                            <%- include("productItem",{product:product}) %>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="text-center py-5">

                    <h5>No Products Found</h5>

                    <p class="text-muted">
                        Click the button above to add your first product.
                    </p>

                </div>

            <% } %>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>